# Copia este archivo como .env y pon los valores que te pasen por fuera del repo.
# Solo llaves públicas: este archivo viaja dentro de la app.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=<anon key: Dashboard → Settings → API Keys → anon>

# AWS Cognito: outputs del stack jcv-cognito-dev (aws/cognito/cloudformation.yaml).
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=<AppClientId>
# Output HostedUiDomain. Vacío: no sale el botón de Google.
COGNITO_DOMAIN=https://jcv-dev-auth.auth.us-east-1.amazoncognito.com
